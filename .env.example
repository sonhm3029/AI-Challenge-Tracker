# Postgres connection string used by the app and by drizzle-kit / jobs.
DATABASE_URL=postgres://tracker:tracker@localhost:5544/challenge_tracker

# Public site URL used for canonical links / OpenGraph / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the admin session cookie. Generate with `openssl rand -hex 32`.
ADMIN_AUTH_SECRET=dev-only-secret-change-me

# Password for the single internal admin account (Section 22: password-protected internal account).
ADMIN_PASSWORD=change-me

# Bearer token required to call POST /api/cron/crawl.
CRON_SECRET=dev-only-cron-secret-change-me

# Optional error monitoring.
SENTRY_DSN=

# Whether the Playwright fallback renderer is allowed to run (Section 12.4 / 61).
PLAYWRIGHT_ENABLED=true

# LLM fallback is disabled by default (Section 36 / 61) and not required for normal operation.
LLM_FALLBACK_ENABLED=false
LLM_API_KEY=
